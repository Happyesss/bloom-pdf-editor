{
  "name": "@bloom/document-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bloom Document Intelligence Engine — PDF → IDM → exporters",
  "exports": {
    ".": {
      "types": "./dist/lib-entry.d.ts",
      "import": "./dist/lib-entry.js",
      "default": "./dist/lib-entry.js"
    }
  },
  "types": "./dist/lib-entry.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
